@model GymAssist.Models.AdminUserViewModel
@{
    ViewData["Title"] = "Editar usuario";
}

<div class="admin-shell">
    <div class="admin-heading">
        <div>
            <span class="auth-badge">Gestión de usuarios</span>
            <h1>Editar usuario</h1>
            <p>Actualiza los datos y permisos de la cuenta.</p>
        </div>
        <a asp-action="Usuarios" class="btn btn-outline-light">Volver</a>
    </div>

    <form asp-action="EditarUsuario" method="post" class="admin-form">
        <input asp-for="IdUsuario" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="admin-form-grid">
            <div>
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Password" class="form-label">Nueva contraseña</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
                <small class="form-text">Déjala vacía para conservar la contraseña actual.</small>
            </div>
            <div>
                <label asp-for="Rol" class="form-label"></label>
                <select asp-for="Rol" class="form-select">
                    <option value="admin">Administrador</option>
                    <option value="pagos">Gestor de pagos</option>
                </select>
                <span asp-validation-for="Rol" class="text-danger"></span>
            </div>
            <div class="form-check form-switch admin-form-check">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label"></label>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
