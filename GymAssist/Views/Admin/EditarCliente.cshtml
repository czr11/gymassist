@model GymAssist.Models.AdminClientViewModel
@{
    ViewData["Title"] = "Editar cliente";
}

<div class="admin-shell">
    <div class="admin-heading">
        <div>
            <span class="auth-badge">Gestión de clientes</span>
            <h1>Editar cliente</h1>
            <p>Actualiza los datos y el estado del cliente.</p>
        </div>
        <a asp-action="Clientes" class="btn btn-outline-light">Volver</a>
    </div>

    <form asp-action="EditarCliente" method="post" class="admin-form">
        <input asp-for="IdCliente" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="admin-form-grid">
            <div>
                <label asp-for="Nombres" class="form-label"></label>
                <input asp-for="Nombres" class="form-control" autocomplete="given-name" />
                <span asp-validation-for="Nombres" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Apellidos" class="form-label"></label>
                <input asp-for="Apellidos" class="form-control" autocomplete="family-name" />
                <span asp-validation-for="Apellidos" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Cedula" class="form-label"></label>
                <input asp-for="Cedula" class="form-control" />
                <span asp-validation-for="Cedula" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Telefono" class="form-label"></label>
                <input asp-for="Telefono" class="form-control" type="tel" autocomplete="tel" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="FechaNacimiento" class="form-label"></label>
                <input asp-for="FechaNacimiento" class="form-control" type="date" />
                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Genero" class="form-label"></label>
                <select asp-for="Genero" class="form-select">
                    <option value="">Selecciona una opción</option>
                    <option value="M">Masculino</option>
                    <option value="F">Femenino</option>
                    <option value="O">Otro</option>
                </select>
                <span asp-validation-for="Genero" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="IdMembresia" class="form-label"></label>
                <select asp-for="IdMembresia" class="form-select">
                    <option value="">Selecciona una membresía</option>
                    @foreach (var membresia in (IEnumerable<GymAssist.Models.Membresia>)ViewBag.Membresias)
                    {
                        <option value="@membresia.IdMembresia">@membresia.Nombre - @membresia.Precio.ToString("C")</option>
                    }
                </select>
                <span asp-validation-for="IdMembresia" class="text-danger"></span>
            </div>
            <div class="admin-form-grid__full">
                <label asp-for="Direccion" class="form-label"></label>
                <textarea asp-for="Direccion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>
            <div class="form-check form-switch admin-form-check">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label"></label>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
