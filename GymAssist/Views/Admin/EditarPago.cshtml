@model GymAssist.Models.AdminPaymentViewModel
@{
    ViewData["Title"] = "Editar pago";
}
<div class="admin-shell">
    <div class="admin-heading"><div><span class="auth-badge">Gestión de pagos</span><h1>Editar pago</h1><p>Actualiza la información de la transacción.</p></div><a asp-action="Pagos" class="btn btn-outline-light">Volver</a></div>
    <form asp-action="EditarPago" method="post" class="admin-form">
        <input asp-for="IdPago" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="admin-form-grid">
            <div><label asp-for="IdCliente" class="form-label"></label><select asp-for="IdCliente" class="form-select">@foreach (var cliente in (IEnumerable<GymAssist.Models.Cliente>)ViewBag.Clientes){<option value="@cliente.IdCliente">@cliente.Nombres @cliente.Apellidos - @cliente.Cedula</option>}</select></div>
            <div><label asp-for="TipoPago" class="form-label"></label><select asp-for="TipoPago" class="form-select"><option value="mensualidad">Mensualidad</option><option value="matricula">Matrícula</option></select></div>
            <div><label asp-for="Monto" class="form-label"></label><input asp-for="Monto" class="form-control" step="0.01" /></div>
            <div><label asp-for="FechaPago" class="form-label"></label><input asp-for="FechaPago" class="form-control" type="date" /></div>
            <div><label asp-for="MetodoPago" class="form-label"></label><select asp-for="MetodoPago" class="form-select"><option value="efectivo">Efectivo</option><option value="tarjeta">Tarjeta</option><option value="transferencia">Transferencia</option><option value="otro">Otro</option></select></div>
            <div><label asp-for="FechaInicio" class="form-label"></label><input asp-for="FechaInicio" class="form-control" type="date" /></div><div><label asp-for="FechaFin" class="form-label"></label><input asp-for="FechaFin" class="form-control" type="date" /></div>
            <div><label asp-for="Estado" class="form-label"></label><select asp-for="Estado" class="form-select"><option value="pagado">Pagado</option><option value="pendiente">Pendiente</option><option value="cancelado">Cancelado</option></select></div><div><label asp-for="Comprobante" class="form-label"></label><input asp-for="Comprobante" class="form-control" /></div>
            <div class="admin-form-grid__full"><label asp-for="Observaciones" class="form-label"></label><textarea asp-for="Observaciones" class="form-control" rows="3"></textarea></div>
        </div><button type="submit" class="btn btn-primary">Guardar cambios</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }