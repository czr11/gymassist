@model GymAssist.Models.AdminClientPageViewModel
@{
    ViewData["Title"] = "Gestión de clientes";
    var clientStatusFilter = ViewData["ClientStatusFilter"]?.ToString() ?? "todos";
}

<div class="admin-shell">
    <div class="admin-heading">
        <div>
            <span class="auth-badge">GymAssist / Administración</span>
            <h1>Gestión de clientes</h1>
            <p>Administra los datos y el estado de los clientes del gimnasio.</p>
        </div>
        <div class="admin-heading__actions">
            <a asp-action="Index" class="btn btn-outline-light">Panel</a>
            <form asp-action="Logout" method="post" class="confirm-action-form" data-confirm-title="¿Estás seguro de que quieres cerrar sesión?" data-confirm-message="Tu sesión administrativa se cerrará en este dispositivo." data-confirm-button="Cerrar sesión">
                <button type="submit" class="btn btn-outline-light">Cerrar sesión</button>
            </form>
        </div>
    </div>

    @if (TempData["AdminNotice"] is not null)
    {
        <div class="alert alert-success">@TempData["AdminNotice"]</div>
    }
    @if (TempData["CreatedClientId"] is not null)
    {
        <div class="admin-summary">
            <div class="admin-summary__header">
                <div>
                    <span class="hero-badge">Cliente registrado</span>
                    <h2>Resumen del registro</h2>
                </div>
                <strong class="admin-summary__id">Client ID: @TempData["CreatedClientId"]</strong>
            </div>
            <div class="admin-summary__grid">
                <div><span>Nombre</span><strong>@TempData["CreatedClientName"]</strong></div>
                <div><span>Cédula</span><strong>@TempData["CreatedClientCedula"]</strong></div>
                <div><span>Membresía</span><strong>@TempData["CreatedClientMembership"]</strong></div>
                <div><span>Vigencia inicial</span><strong>@TempData["CreatedClientValidity"]</strong></div>
            </div>
        </div>
    }
    @if (TempData["AdminError"] is not null)
    {
        <div class="alert alert-danger">@TempData["AdminError"]</div>
    }

    <div class="admin-section-toolbar">
        <div>
            <h2>Clientes registrados</h2>
            <span class="admin-section-toolbar__count">@Model.TotalClientes cliente(s) · Página @Model.PaginaActual de @Model.TotalPaginas</span>
        </div>
        <div class="admin-heading__actions">
            <form asp-action="Clientes" method="get" class="admin-filter-form">
                <label for="estado" class="visually-hidden">Filtrar por estado</label>
                <select id="estado" name="estado" class="form-select admin-filter-select" onchange="this.form.submit()">
                    @if (clientStatusFilter == "todos")
                    {
                        <option value="todos" selected>Todos</option>
                    }
                    else
                    {
                        <option value="todos">Todos</option>
                    }
                    @if (clientStatusFilter == "activos")
                    {
                        <option value="activos" selected>Activos</option>
                    }
                    else
                    {
                        <option value="activos">Activos</option>
                    }
                    @if (clientStatusFilter == "inactivos")
                    {
                        <option value="inactivos" selected>Inactivos</option>
                    }
                    else
                    {
                        <option value="inactivos">Inactivos</option>
                    }
                </select>
            </form>
            <a asp-action="CrearCliente" class="btn btn-primary">Nuevo cliente</a>
        </div>
    </div>

    <div class="admin-table-wrap">
        <table class="table admin-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Client ID</th>
                    <th>Cliente</th>
                    <th>Cédula</th>
                    <th>Contacto</th>
                    <th>Género</th>
                    <th>Estado</th>
                    <th class="admin-table__actions-header">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var cliente in Model.Clientes)
            {
                <tr>
                    <td>@cliente.IdCliente</td>
                    <td>
                        <span class="admin-date">@cliente.Nombres @cliente.Apellidos</span>
                        @if (cliente.FechaNacimiento.HasValue)
                        {
                            <span class="admin-time">Nacimiento: @cliente.FechaNacimiento.Value.ToString("dd/MM/yyyy")</span>
                        }
                    </td>
                    <td>@cliente.Cedula</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(cliente.Email))
                        {
                            <span class="admin-date">@cliente.Email</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(cliente.Telefono))
                        {
                            <span class="admin-time">@cliente.Telefono</span>
                        }
                        @if (string.IsNullOrWhiteSpace(cliente.Email) && string.IsNullOrWhiteSpace(cliente.Telefono))
                        {
                            <span class="admin-date admin-date--empty">Sin contacto</span>
                        }
                    </td>
                    <td>@(cliente.Genero?.ToString() ?? "-")</td>
                    <td>
                        <span class="admin-status @(cliente.Activo ? "admin-status--active" : "admin-status--inactive")">
                            @(cliente.Activo ? "Activo" : "Inactivo")
                        </span>
                    </td>
                    <td class="admin-table__actions-cell">
                        <div class="admin-row-actions">
                            <a asp-action="EditarCliente" asp-route-id="@cliente.IdCliente" class="admin-action admin-action--edit">
                                <span class="admin-action__icon">E</span>
                                <span>Editar</span>
                            </a>
                            @if (cliente.Activo)
                            {
                                <form asp-action="EliminarCliente" asp-route-id="@cliente.IdCliente" method="post" class="confirm-action-form" data-confirm-title="¿Eliminar este cliente?" data-confirm-message="La cuenta se desactivará y conservará su historial." data-confirm-button="Eliminar cliente">
                                    <button type="submit" class="admin-action admin-action--delete">
                                        <span class="admin-action__icon">X</span>
                                        <span>Eliminar</span>
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <nav class="admin-pagination" aria-label="Paginación de clientes">
            @if (Model.TienePaginaAnterior)
            {
                <a asp-action="Clientes" asp-route-pagina="@(Model.PaginaActual - 1)" asp-route-estado="@clientStatusFilter" class="admin-pagination__link">Anterior</a>
            }
            else
            {
                <span class="admin-pagination__link admin-pagination__link--disabled">Anterior</span>
            }

            <div class="admin-pagination__pages">
                @for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                {
                    if (pagina == Model.PaginaActual)
                    {
                        <span class="admin-pagination__link admin-pagination__link--active">@pagina</span>
                    }
                    else
                    {
                        <a asp-action="Clientes" asp-route-pagina="@pagina" asp-route-estado="@clientStatusFilter" class="admin-pagination__link">@pagina</a>
                    }
                }
            </div>

            @if (Model.TienePaginaSiguiente)
            {
                <a asp-action="Clientes" asp-route-pagina="@(Model.PaginaActual + 1)" asp-route-estado="@clientStatusFilter" class="admin-pagination__link">Siguiente</a>
            }
            else
            {
                <span class="admin-pagination__link admin-pagination__link--disabled">Siguiente</span>
            }
        </nav>
    }
</div>
