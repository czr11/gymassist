@model GymAssist.Models.AdminMembershipViewModel
@{
    ViewData["Title"] = "Editar membresía";
}
<div class="admin-shell">
    <div class="admin-heading"><div><span class="auth-badge">Gestión de membresías</span><h1>Editar membresía</h1><p>Actualiza el plan sin alterar su historial de pagos.</p></div><a asp-action="Membresias" class="btn btn-outline-light">Volver</a></div>
    <form asp-action="EditarMembresia" method="post" class="admin-form">
        <input asp-for="IdMembresia" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="admin-form-grid">
            <div><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
            <div><label asp-for="Precio" class="form-label"></label><input asp-for="Precio" class="form-control" type="number" step="0.01" min="0.01" /><span asp-validation-for="Precio" class="text-danger"></span></div>
            <div><label asp-for="DuracionDias" class="form-label"></label><input asp-for="DuracionDias" class="form-control" type="number" min="1" /><span asp-validation-for="DuracionDias" class="text-danger"></span></div>
            <div class="admin-form-grid__full"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" class="form-control" rows="3"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div>
            <div class="admin-form-grid__full"><span class="form-label">Beneficios incluidos</span><div class="d-flex gap-4 flex-wrap"><label class="form-check"><input asp-for="AccesoSalas" class="form-check-input" /><span class="form-check-label">Acceso a salas</span></label><label class="form-check"><input asp-for="AccesoEntrenador" class="form-check-input" /><span class="form-check-label">Acceso a entrenador</span></label><label class="form-check"><input asp-for="AccesoSpa" class="form-check-input" /><span class="form-check-label">Acceso a spa</span></label></div></div>
            <div><label class="form-check"><input asp-for="Activo" class="form-check-input" /><span class="form-check-label">Membresía activa</span></label></div>
        </div>
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
