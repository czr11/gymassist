@model GymAssist.Models.CheckInViewModel
@{
    ViewData["Title"] = "Check-in Self Service";
}

<div class="hero-shell">
    <div class="top-toolbar">
        <div class="top-toolbar__actions">
            <div class="gym-selector compact">
                <label asp-for="GymName" class="form-label"></label>
                <select asp-for="GymName" class="form-select form-select-sm">
                    <option value="Alphamma.sv">Alphamma.sv</option>
                </select>
                <span asp-validation-for="GymName" class="text-danger"></span>
            </div>
            <a asp-controller="Admin" asp-action="Login" class="admin-link">Staff login <span aria-hidden="true">↗</span></a>
        </div>
    </div>

    <section class="hero-card">
        <div class="hero-copy">
            <div class="hero-kicker"><span class="hero-kicker__line"></span> Alphamma.sv / San Salvador</div>
            <span class="hero-badge">Kickboxing · Fuerza · Disciplina</span>
            <h1>Entrena como si cada round <em>contara.</em></h1>
            <p class="hero-lede">Un espacio para quienes vienen a moverse con intención. Confirma tu acceso y entra directo a tu próxima sesión.</p>

            <div class="hero-actions">
                <button type="button" class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#checkinModal">
                    Confirmar mi acceso <span aria-hidden="true">→</span>
                </button>
                <span class="hero-note"><span class="hero-note__dot"></span> Recepción abierta · 05:30 — 22:00</span>
            </div>
        </div>

        <div class="hero-visual" aria-label="Ilustración decorativa de un ring de kickboxing">
            <div class="hero-visual__label">ROUND <strong>01</strong></div>
            <div class="ring-graphic">
                <span class="ring-graphic__rope ring-graphic__rope--one"></span>
                <span class="ring-graphic__rope ring-graphic__rope--two"></span>
                <span class="ring-graphic__rope ring-graphic__rope--three"></span>
                <span class="ring-graphic__corner ring-graphic__corner--left"></span>
                <span class="ring-graphic__corner ring-graphic__corner--right"></span>
                <span class="ring-graphic__glove ring-graphic__glove--left">A</span>
                <span class="ring-graphic__glove ring-graphic__glove--right">F</span>
            </div>
            <div class="hero-visual__caption"><span>01</span><span>02</span><span>03</span><strong>READY</strong></div>
        </div>
    </section>

    <section class="home-strip" aria-label="Información del gimnasio">
        <div><span class="home-strip__number">01</span><strong>Check-in sin filas</strong><small>Consulta tu acceso en segundos</small></div>
        <div><span class="home-strip__number">02</span><strong>Clases con propósito</strong><small>Kickboxing para todos los niveles</small></div>
        <div><span class="home-strip__number">03</span><strong>Tu sesión empieza aquí</strong><small>Trae tu energía. Nosotros ponemos el ring.</small></div>
    </section>
</div>

<div class="modal fade" id="checkinModal" tabindex="-1" aria-labelledby="checkinModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-modal modal-hero">
            <div class="modal-body p-0">
                <div class="modal-hero__content">
                    <div class="modal-hero__copy">
                        <span class="hero-badge">Check-in self-service</span>
                        <h2 id="checkinModalLabel">Tu entrada, más rápida</h2>
                        <p>Completa solo un dato y descubre si tu membresía está al día, próxima a vencer o con pago atrasado.</p>
                    </div>
                    <div class="modal-hero__form">
                        <form asp-action="CheckIn" method="post" class="checkin-form">
                                <div class="mb-4">
                                <label asp-for="Identificador" class="form-label"></label>
                                <input asp-for="Identificador" class="form-control" placeholder="Correo, ID o teléfono" />
                                <span asp-validation-for="Identificador" class="text-danger"></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-primary">Confirmar check-in</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.ResultMessage != null)
{
    <div class="modal fade show result-modal-visible" id="resultModal" tabindex="-1" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-modal modal-result result-@Model.ResultLevel">
                <div class="modal-body text-center p-4">
                    <h3 class="mb-2">@Model.ResultTitle</h3>
                    <p class="mb-3">@Model.ResultMessage</p>
                    @if (Model.ResultDetail != null)
                    {
                        <p class="small mt-3 mb-0">@Model.ResultDetail</p>
                    }
                    <button type="button" class="btn btn-primary mt-4" id="resultModalClose">Aceptar</button>
                </div>
            </div>
        </div>
    </div>
}
